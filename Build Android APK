                              text = dateFormat.format(Date(run.timestampEpochMs)),
                              color = Color.Gray,
                              fontSize = 11.sp,
                              fontFamily = FontFamily.Monospace
                          )
                      }
                      IconButton(onClick = onDelete) {
                          Icon(Icons.Default.Delete, contentDescription = "Delete", tint = Color(0xFFFF5252))
                      }
                  }

                  Spacer(modifier = Modifier.height(8.dp))

                  Row(
                      modifier = Modifier.fillMaxWidth(),
                      horizontalArrangement = Arrangement.SpaceBetween,
                      verticalAlignment = Alignment.Bottom
                  ) {
                      Text(
                          text = formatMsToSec(run.primaryTimeMs),
                          color = Color.White,
                          fontSize = 30.sp,
                          fontWeight = FontWeight.Black,
                          fontFamily = FontFamily.Monospace
                      )
                      Text(
                          text = if (isQuarter) {
                              String.format(Locale.US, "@ %.1f km/h", run.trapSpeedKmh)
                          } else {
                              String.format(Locale.US, "%.1f m", run.totalDistanceM)
                          },
                          color = Color(0xFF00B0FF),
                          fontSize = 16.sp,
                          fontWeight = FontWeight.Bold,
                          fontFamily = FontFamily.Monospace
                      )
                  }

                  Spacer(modifier = Modifier.height(8.dp))
                  HorizontalDivider(color = Color(0xFF263238))
                  Spacer(modifier = Modifier.height(8.dp))

                  if (isQuarter) {
                      Text(
                          text = "60': ${formatNullableMs(run.time60ftMs)}  |  1/8: ${formatNullableMs(run.timeEighthMileMs)}  |  0-100: ${formatNullableMs(run.time0to100Ms)}",
                          color = Color(0xFFB0BEC5),
                          fontSize = 12.sp,
                          fontFamily = FontFamily.Monospace
                      )
                  } else {
                      Text(
                          text = "100-150: ${formatNullableMs(run.time100to150Ms)}  |  150-200: ${formatNullableMs(run.time150to200Ms)}",
                          color = Color(0xFFB0BEC5),
                          fontSize = 12.sp,
                          fontFamily = FontFamily.Monospace
                      )
                  }

                  Spacer(modifier = Modifier.height(4.dp))
                  Text(
                      text = String.format(
                          Locale.US,
                          "Slope: %.2f%% (%s) • Peak: %.2fG • Rollout: %s",
                          run.slopePercent,
                          if (run.isValidSlope) "VALID" else "INVALID",
                          run.peakG,
                          if (run.rolloutEnabled) "ON" else "OFF"
                      ),
                      color = if (run.isValidSlope) Color(0xFF78909C) else Color(0xFFFF5252),
                      fontSize = 11.sp,
                      fontFamily = FontFamily.Monospace
                  )
              }
          }

          @Composable
          fun TabButton(
              text: String,
              selected: Boolean,
              modifier: Modifier = Modifier,
              onClick: () -> Unit
          ) {
              Box(
                  modifier = modifier
                      .clip(RoundedCornerShape(8.dp))
                      .background(if (selected) Color(0xFF00E676) else Color.Transparent)
                      .clickable { onClick() }
                      .padding(vertical = 10.dp),
                  contentAlignment = Alignment.Center
              ) {
                  Text(
                      text = text,
                      color = if (selected) Color.Black else Color.Gray,
                      fontWeight = FontWeight.Bold,
                      fontSize = 13.sp,
                      fontFamily = FontFamily.Monospace
                  )
              }
          }

          @Composable
          fun MetricPill(label: String, value: String) {
              Column(horizontalAlignment = Alignment.CenterHorizontally) {
                  Text(text = label, color = Color.Gray, fontSize = 10.sp, fontFamily = FontFamily.Monospace)
                  Text(
                      text = value,
                      color = Color.White,
                      fontSize = 14.sp,
                      fontWeight = FontWeight.Bold,
                      fontFamily = FontFamily.Monospace
                  )
              }
          }

          @Composable
          fun SlipRow(label: String, value: String, highlight: Boolean = false) {
              Row(
                  modifier = Modifier
                      .fillMaxWidth()
                      .padding(vertical = 6.dp),
                  horizontalArrangement = Arrangement.SpaceBetween
              ) {
                  Text(
                      text = label,
                      color = if (highlight) Color(0xFF00E676) else Color(0xFFB0BEC5),
                      fontSize = if (highlight) 14.sp else 13.sp,
                      fontWeight = if (highlight) FontWeight.Bold else FontWeight.Normal,
                      fontFamily = FontFamily.Monospace
                  )
                  Text(
                      text = value,
                      color = if (highlight) Color(0xFF00E676) else Color.White,
                      fontSize = if (highlight) 15.sp else 13.sp,
                      fontWeight = FontWeight.Bold,
                      fontFamily = FontFamily.Monospace
                  )
              }
          }

          fun formatMsToSec(ms: Long): String {
              val seconds = ms / 1000
              val millis = ms % 1000
              return String.format(Locale.US, "%d.%03ds", seconds, millis)
          }

          fun formatNullableMs(ms: Long?): String {
              return if (ms != null) formatMsToSec(ms) else "--.---"
          }

          fun shareRunsAsCsv(context: Context, runs: List<RunRecord>) {
              val sb = StringBuilder()
              sb.appendLine("ID,Timestamp,Mode,PrimaryTime_s,TrapSpeed_kmh,Distance_m,60ft_s,330ft_s,EighthMile_s,EighthSpeed_kmh,1000ft_s,0_100_s,100_150_s,150_200_s,Slope_pct,ValidSlope,PeakG,Rollout,GPS_Hz")
              for (r in runs) {
                  sb.appendLine(
                      "${r.id},${r.timestampEpochMs},${r.testMode},${r.primaryTimeMs / 1000.0},${r.trapSpeedKmh},${r.totalDistanceM}," +
                              "${r.time60ftMs?.div(1000.0) ?: ""},${r.time330ftMs?.div(1000.0) ?: ""},${r.timeEighthMileMs?.div(1000.0) ?: ""},${r.speedEighthMileKmh ?: ""}," +
                              "${r.time1000ftMs?.div(1000.0) ?: ""},${r.time0to100Ms?.div(1000.0) ?: ""},${r.time100to150Ms?.div(1000.0) ?: ""},${r.time150to200Ms?.div(1000.0) ?: ""}," +
                              "${r.slopePercent},${r.isValidSlope},${r.peakG},${r.rolloutEnabled},${r.gpsHz}"
                  )
              }

              val sendIntent = Intent(Intent.ACTION_SEND).apply {
                  type = "text/csv"
                  putExtra(Intent.EXTRA_SUBJECT, "GPS Performance Runs Telemetry CSV")
                  putExtra(Intent.EXTRA_TEXT, sb.toString())
              }
              context.startActivity(Intent.createChooser(sendIntent, "Export Telemetry CSV"))
          }
