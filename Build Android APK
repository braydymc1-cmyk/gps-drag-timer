          cat << 'EOF' > app/src/main/java/com/performance/gpstimer/RunDatabase.kt
          package com.performance.gpstimer

          import android.content.Context
          import androidx.room.*
          import kotlinx.coroutines.flow.Flow

          @Entity(tableName = "performance_runs")
          data class RunRecord(
              @PrimaryKey(autoGenerate = true) val id: Long = 0,
              val timestampEpochMs: Long,
              val testMode: String,
              val primaryTimeMs: Long,
              val trapSpeedKmh: Double,
              val totalDistanceM: Double,
              val time60ftMs: Long? = null,
              val time330ftMs: Long? = null,
              val timeEighthMileMs: Long? = null,
              val speedEighthMileKmh: Double? = null,
              val time1000ftMs: Long? = null,
              val time0to100Ms: Long? = null,
              val time100to150Ms: Long? = null,
              val time150to200Ms: Long? = null,
              val slopePercent: Double,
              val isValidSlope: Boolean,
              val peakG: Double,
              val rolloutEnabled: Boolean,
              val gpsHz: Double
          )

          @Dao
          interface RunDao {
              @Query("SELECT * FROM performance_runs ORDER BY timestampEpochMs DESC")
              fun getAllRuns(): Flow<List<RunRecord>>

              @Insert(onConflict = OnConflictStrategy.REPLACE)
              suspend fun insertRun(run: RunRecord): Long

              @Delete
              suspend fun deleteRun(run: RunRecord)
          }

          @Database(entities = [RunRecord::class], version = 1, exportSchema = false)
          abstract class AppDatabase : RoomDatabase() {
              abstract fun runDao(): RunDao

              companion object {
                  @Volatile
                  private var INSTANCE: AppDatabase? = null

                  fun getInstance(context: Context): AppDatabase {
                      return INSTANCE ?: synchronized(this) {
                          Room.databaseBuilder(
                              context.applicationContext,
                              AppDatabase::class.java,
                              "gps_drag_timer.db"
                          ).build().also { INSTANCE = it }
                      }
                  }
              }
          }
          EOF

          cat << 'EOF' > app/src/main/java/com/performance/gpstimer/GpsTelemetryService.kt
          package com.performance.gpstimer

          import android.annotation.SuppressLint
          import android.app.*
          import android.content.Context
          import android.content.Intent
          import android.content.pm.ServiceInfo
          import android.location.GnssStatus
          import android.location.Location
          import android.location.LocationListener
          import android.location.LocationManager
          import android.os.*
          import androidx.core.app.NotificationCompat
          import kotlinx.coroutines.*
          import kotlinx.coroutines.flow.MutableStateFlow
          import kotlinx.coroutines.flow.StateFlow
          import kotlinx.coroutines.flow.asStateFlow
          import kotlin.math.max

          data class TelemetryUiState(
              val mode: TestMode = TestMode.QUARTER_MILE,
              val status: RunStatus = RunStatus.IDLE,
              val rolloutEnabled: Boolean = true,
              val currentSpeedKmh: Double = 0.0,
              val currentG: Double = 0.0,
              val peakG: Double = 0.0,
              val liveElapsedMs: Long = 0L,
              val liveDistanceM: Double = 0.0,
              val satellitesUsed: Int = 0,
              val satellitesVisible: Int = 0,
              val accuracyM: Float = 0f,
              val currentHz: Double = 0.0,
              val latestRun: RunRecord? = null
          )

          class GpsTelemetryService : Service(), LocationListener {

              private val binder = LocalBinder()
              private val serviceScope = CoroutineScope(SupervisorJob() + Dispatchers.Default)

              private lateinit var locationManager: LocationManager
              private lateinit var database: AppDatabase
              private var wakeLock: PowerManager.WakeLock? = null

              private val _uiState = MutableStateFlow(TelemetryUiState())
              val uiState: StateFlow<TelemetryUiState> = _uiState.asStateFlow()

              private var prevSample: GpsSample? = null
              private var runStartTimeNanos: Long = 0L
              private var runStartDistanceM: Double = 0.0
              private var runStartAltitudeM: Double = 0.0
              private var cumulativeDistanceM: Double = 0.0
              private var stagingOriginDistanceM: Double = 0.0

              private val recentFixTimesNanos = ArrayDeque<Long>(12)

              private var split60ftMs: Long? = null
              private var split330ftMs: Long? = null
              private var splitEighthMs: Long? = null
              private var speedEighthKmh: Double? = null
              private var split1000ftMs: Long? = null
              private var split0to100Ms: Long? = null
              private var split100to150Ms: Long? = null
              private var timeAt150Nanos: Long? = null
              private var peakRunG: Double = 0.0

              inner class LocalBinder : Binder() {
                  fun getService(): GpsTelemetryService = this@GpsTelemetryService
              }

              override fun onBind(intent: Intent?): IBinder = binder

              override fun onCreate() {
                  super.onCreate()
                  database = AppDatabase.getInstance(this)
                  locationManager = getSystemService(Context.LOCATION_SERVICE) as LocationManager
                  acquireWakeLock()
                  startForegroundServiceNotification()
                  startRawGpsUpdates()
              }

              private val gnssCallback = object : GnssStatus.Callback() {
                  override fun onSatelliteStatusChanged(status: GnssStatus) {
                      var used = 0
                      val total = status.satelliteCount
                      for (i in 0 until total) {
                          if (status.usedInFix(i)) used++
                      }
                      _uiState.value = _uiState.value.copy(
                          satellitesUsed = used,
                          satellitesVisible = total
                      )
                  }
              }

              @SuppressLint("MissingPermission")
              fun startRawGpsUpdates() {
                  try {
                      locationManager.requestLocationUpdates(
                          LocationManager.GPS_PROVIDER,
                          0L,
                          0f,
                          this,
                          Looper.getMainLooper()
                      )
                      locationManager.registerGnssStatusCallback(
                          gnssCallback,
                          Handler(Looper.getMainLooper())
                      )
                  } catch (_: SecurityException) {}
              }

              fun setTestMode(mode: TestMode) {
                  disarmRun()
                  _uiState.value = _uiState.value.copy(mode = mode, latestRun = null)
              }

              fun toggleRollout(enabled: Boolean) {
                  _uiState.value = _uiState.value.copy(rolloutEnabled = enabled)
              }

              fun armSystem() {
                  resetRunMetrics()
                  val state = _uiState.value
                  val nextStatus = when (state.mode) {
                      TestMode.QUARTER_MILE -> RunStatus.STAGED_STOP
                      TestMode.ROLL_100_200 -> RunStatus.STAGED_ROLL
                  }
                  _uiState.value = state.copy(
                      status = nextStatus,
                      liveElapsedMs = 0L,
                      liveDistanceM = 0.0,
                      peakG = 0.0
                  )
              }

              fun disarmRun() {
                  resetRunMetrics()
                  _uiState.value = _uiState.value.copy(
                      status = RunStatus.IDLE,
                      liveElapsedMs = 0L,
                      liveDistanceM = 0.0
                  )
              }

              private fun resetRunMetrics() {
                  runStartTimeNanos = 0L
                  runStartDistanceM = 0.0
                  runStartAltitudeM = 0.0
                  stagingOriginDistanceM = cumulativeDistanceM
                  split60ftMs = null
                  split330ftMs = null
                  splitEighthMs = null
                  speedEighthKmh = null
                  split1000ftMs = null
                  split0to100Ms = null
                  split100to150Ms = null
                  timeAt150Nanos = null
                  peakRunG = 0.0
              }

              override fun onLocationChanged(location: Location) {
                  val nowNanos = location.elapsedRealtimeNanos
                  val rawSpeedMps = if (location.hasSpeed()) location.speed.toDouble() else 0.0
                  val speedMps = if (rawSpeedMps < 0.33) 0.0 else rawSpeedMps
                  val speedKmh = speedMps * 3.6
                  val altM = if (location.hasAltitude()) location.altitude else 0.0
                  val accM = if (location.hasAccuracy()) location.accuracy else 99f

                  recentFixTimesNanos.addLast(nowNanos)
                  if (recentFixTimesNanos.size > 10) recentFixTimesNanos.removeFirst()
                  val hz = if (recentFixTimesNanos.size >= 2) {
                      val spanSec = (recentFixTimesNanos.last() - recentFixTimesNanos.first()) / 1_000_000_000.0
                      if (spanSec > 0) (recentFixTimesNanos.size - 1) / spanSec else 1.0
                  } else 1.0

                  val previous = prevSample
                  var longG = 0.0

                  if (previous != null) {
                      val dtSec = (nowNanos - previous.elapsedNanos) / 1_000_000_000.0
                      if (dtSec in 0.005..5.0) {
                          val avgSpeedMps = 0.5 * (previous.speedMps + speedMps)
                          cumulativeDistanceM += avgSpeedMps * dtSec
                          val accelMps2 = (speedMps - previous.speedMps) / dtSec
                          longG = accelMps2 / 9.80665
                      }
                  }

                  val currentSample = GpsSample(
                      elapsedNanos = nowNanos,
                      speedMps = speedMps,
                      speedKmh = speedKmh,
                      cumulativeDistanceM = cumulativeDistanceM,
                      altitudeM = altM,
                      accuracyM = accM,
                      longitudinalG = longG
                  )

                  if (previous != null) {
                      processStateMachine(previous, currentSample, hz)
                  }

                  prevSample = currentSample

                  _uiState.value = _uiState.value.copy(
                      currentSpeedKmh = speedKmh,
                      currentG = longG,
                      accuracyM = accM,
                      currentHz = hz
                  )
              }

              private fun processStateMachine(s1: GpsSample, s2: GpsSample, hz: Double) {
                  val state = _uiState.value
                  when (state.mode) {
                      TestMode.QUARTER_MILE -> processQuarterMile(state, s1, s2, hz)
                      TestMode.ROLL_100_200 -> processRoll100To200(state, s1, s2, hz)
                  }
              }

              private fun processQuarterMile(state: TelemetryUiState, s1: GpsSample, s2: GpsSample, hz: Double) {
                  when (state.status) {
                      RunStatus.STAGED_STOP -> {
                          if (s2.speedKmh < TimingConstants.LAUNCH_SPEED_THRESHOLD_KMH) {
                              stagingOriginDistanceM = s2.cumulativeDistanceM
                          } else {
                              if (!state.rolloutEnabled) {
                                  runStartTimeNanos = TimingMath.interpolateTimeAtSpeed(s1, s2, TimingConstants.LAUNCH_SPEED_THRESHOLD_KMH)
                                  runStartDistanceM = TimingMath.interpolateDistanceAtSpeed(s1, s2, TimingConstants.LAUNCH_SPEED_THRESHOLD_KMH)
                                  runStartAltitudeM = TimingMath.interpolateAltitudeAtSpeed(s1, s2, TimingConstants.LAUNCH_SPEED_THRESHOLD_KMH)
                                  _uiState.value = _uiState.value.copy(status = RunStatus.RUNNING)
                                  checkQuarterMileSplits(s1, s2, hz)
                              } else {
                                  val rolloutTargetM = stagingOriginDistanceM + TimingConstants.ONE_FOOT_M
                                  if (s2.cumulativeDistanceM >= rolloutTargetM) {
                                      runStartTimeNanos = TimingMath.interpolateTimeAtDistance(s1, s2, rolloutTargetM)
                                      runStartDistanceM = rolloutTargetM
                                      runStartAltitudeM = TimingMath.interpolateAltitudeAtDistance(s1, s2, rolloutTargetM)
                                      _uiState.value = _uiState.value.copy(status = RunStatus.RUNNING)
                                      checkQuarterMileSplits(s1, s2, hz)
                                  }
                              }
                          }
                      }
                      RunStatus.RUNNING -> checkQuarterMileSplits(s1, s2, hz)
                      else -> Unit
                  }
              }

              private fun checkQuarterMileSplits(s1: GpsSample, s2: GpsSample, hz: Double) {
                  peakRunG = max(peakRunG, s2.longitudinalG)
                  val currentRunDist = max(0.0, s2.cumulativeDistanceM - runStartDistanceM)
                  val currentElapsedMs = max(0L, (s2.elapsedNanos - runStartTimeNanos) / 1_000_000L)

                  if (split0to100Ms == null && s2.speedKmh >= 100.0) {
                      val crossNanos = TimingMath.interpolateTimeAtSpeed(s1, s2, 100.0)
                      split0to100Ms = max(0L, (crossNanos - runStartTimeNanos) / 1_000_000L)
                  }

                  val target60 = runStartDistanceM + TimingConstants.DIST_60_FT_M
                  if (split60ftMs == null && s2.cumulativeDistanceM >= target60) {
                      val crossNanos = TimingMath.interpolateTimeAtDistance(s1, s2, target60)
                      split60ftMs = max(0L, (crossNanos - runStartTimeNanos) / 1_000_000L)
                  }

                  val target330 = runStartDistanceM + TimingConstants.DIST_330_FT_M
                  if (split330ftMs == null && s2.cumulativeDistanceM >= target330) {
                      val crossNanos = TimingMath.interpolateTimeAtDistance(s1, s2, target330)
                      split330ftMs = max(0L, (crossNanos - runStartTimeNanos) / 1_000_000L)
                  }

                  val targetEighth = runStartDistanceM + TimingConstants.DIST_EIGHTH_MILE_M
                  if (splitEighthMs == null && s2.cumulativeDistanceM >= targetEighth) {
                      val crossNanos = TimingMath.interpolateTimeAtDistance(s1, s2, targetEighth)
                      splitEighthMs = max(0L, (crossNanos - runStartTimeNanos) / 1_000_000L)
                      speedEighthKmh = TimingMath.interpolateSpeedAtDistance(s1, s2, targetEighth)
                  }

                  val target1000 = runStartDistanceM + TimingConstants.DIST_1000_FT_M
                  if (split1000ftMs == null && s2.cumulativeDistanceM >= target1000) {
                      val crossNanos = TimingMath.interpolateTimeAtDistance(s1, s2, target1000)
                      split1000ftMs = max(0L, (crossNanos - runStartTimeNanos) / 1_000_000L)
                  }

                  val targetQuarter = runStartDistanceM + TimingConstants.DIST_QUARTER_MILE_M
                  if (s2.cumulativeDistanceM >= targetQuarter) {
                      val finishNanos = TimingMath.interpolateTimeAtDistance(s1, s2, targetQuarter)
                      val totalTimeMs = max(0L, (finishNanos - runStartTimeNanos) / 1_000_000L)
                      val trapSpeedKmh = TimingMath.interpolateSpeedAtDistance(s1, s2, targetQuarter)
                      val endAltM = TimingMath.interpolateAltitudeAtDistance(s1, s2, targetQuarter)
                      val slope = TimingMath.calculateSlopePercent(runStartAltitudeM, endAltM, TimingConstants.DIST_QUARTER_MILE_M)

                      val completedRecord = RunRecord(
                          timestampEpochMs = System.currentTimeMillis(),
                          testMode = TestMode.QUARTER_MILE.name,
                          primaryTimeMs = totalTimeMs,
                          trapSpeedKmh = trapSpeedKmh,
                          totalDistanceM = TimingConstants.DIST_QUARTER_MILE_M,
                          time60ftMs = split60ftMs,
                          time330ftMs = split330ftMs,
                          timeEighthMileMs = splitEighthMs,
                          speedEighthMileKmh = speedEighthKmh,
                          time1000ftMs = split1000ftMs,
                          time0to100Ms = split0to100Ms,
                          slopePercent = slope,
                          isValidSlope = slope >= -1.0,
                          peakG = peakRunG,
                          rolloutEnabled = _uiState.value.rolloutEnabled,
                          gpsHz = hz
                      )
                      saveCompletedRun(completedRecord)
                      return
                  }

                  _uiState.value = _uiState.value.copy(
                      liveElapsedMs = currentElapsedMs,
                      liveDistanceM = currentRunDist,
                      peakG = peakRunG
                  )
              }

              private fun processRoll100To200(state: TelemetryUiState, s1: GpsSample, s2: GpsSample, hz: Double) {
                  when (state.status) {
                      RunStatus.STAGED_ROLL -> {
                          if (s1.speedKmh < 100.0 && s2.speedKmh >= 100.0) {
                              runStartTimeNanos = TimingMath.interpolateTimeAtSpeed(s1, s2, 100.0)
                              runStartDistanceM = TimingMath.interpolateDistanceAtSpeed(s1, s2, 100.0)
                              runStartAltitudeM = TimingMath.interpolateAltitudeAtSpeed(s1, s2, 100.0)
                              _uiState.value = _uiState.value.copy(status = RunStatus.RUNNING)
                              checkRoll100To200Splits(s1, s2, hz)
                          }
                      }
                      RunStatus.RUNNING -> {
                          if (s2.speedKmh < 90.0) {
                              armSystem()
                              return
                          }
                          checkRoll100To200Splits(s1, s2, hz)
                      }
                      else -> Unit
                  }
              }

              private fun checkRoll100To200Splits(s1: GpsSample, s2: GpsSample, hz: Double) {
                  peakRunG = max(peakRunG, s2.longitudinalG)
                  val currentRunDist = max(0.0, s2.cumulativeDistanceM - runStartDistanceM)
                  val currentElapsedMs = max(0L, (s2.elapsedNanos - runStartTimeNanos) / 1_000_000L)

                  if (split100to150Ms == null && s2.speedKmh >= 150.0) {
                      val cross150Nanos = TimingMath.interpolateTimeAtSpeed(s1, s2, 150.0)
                      timeAt150Nanos = cross150Nanos
                      split100to150Ms = max(0L, (cross150Nanos - runStartTimeNanos) / 1_000_000L)
                  }

                  if (s2.speedKmh >= 200.0) {
                      val finishNanos = TimingMath.interpolateTimeAtSpeed(s1, s2, 200.0)
                      val totalTimeMs = max(0L, (finishNanos - runStartTimeNanos) / 1_000_000L)
                      val endDistM = TimingMath.interpolateDistanceAtSpeed(s1, s2, 200.0)
                      val endAltM = TimingMath.interpolateAltitudeAtSpeed(s1, s2, 200.0)
                      val runDistM = max(1.0, endDistM - runStartDistanceM)
                      val slope = TimingMath.calculateSlopePercent(runStartAltitudeM, endAltM, runDistM)

                      val split150to200 = timeAt150Nanos?.let { t150 ->
                          max(0L, (finishNanos - t150) / 1_000_000L)
                      }

                      val completedRecord = RunRecord(
                          timestampEpochMs = System.currentTimeMillis(),
                          testMode = TestMode.ROLL_100_200.name,
                          primaryTimeMs = totalTimeMs,
                          trapSpeedKmh = 200.0,
                          totalDistanceM = runDistM,
                          time100to150Ms = split100to150Ms,
                          time150to200Ms = split150to200,
                          slopePercent = slope,
                          isValidSlope = slope >= -1.0,
                          peakG = peakRunG,
                          rolloutEnabled = false,
                          gpsHz = hz
                      )
                      saveCompletedRun(completedRecord)
                      return
                  }

                  _uiState.value = _uiState.value.copy(
                      liveElapsedMs = currentElapsedMs,
                      liveDistanceM = currentRunDist,
                      peakG = peakRunG
                  )
              }

              private fun saveCompletedRun(record: RunRecord) {
                  serviceScope.launch {
                      database.runDao().insertRun(record)
                  }
                  _uiState.value = _uiState.value.copy(
                      status = RunStatus.COMPLETED,
                      liveElapsedMs = record.primaryTimeMs,
                      liveDistanceM = record.totalDistanceM,
                      latestRun = record
                  )
              }

              private fun acquireWakeLock() {
                  val pm = getSystemService(Context.POWER_SERVICE) as PowerManager
                  wakeLock = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "GpsDragTimer::WakeLock").apply {
                      acquire(2 * 60 * 60 * 1000L)
                  }
              }

              private fun startForegroundServiceNotification() {
                  val channelId = "gps_telemetry_channel"
                  val channel = NotificationChannel(
                      channelId,
                      "High Precision GPS Telemetry",
                      NotificationManager.IMPORTANCE_LOW
                  )
                  val nm = getSystemService(NotificationManager::class.java)
                  nm.createNotificationChannel(channel)

                  val notification = NotificationCompat.Builder(this, channelId)
                      .setContentTitle("GPS Performance Timer Active")
                      .setContentText("High-frequency GNSS polling locked")
                      .setSmallIcon(android.R.drawable.ic_menu_compass)
                      .setOngoing(true)
                      .build()

                  if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                      startForeground(1001, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_LOCATION)
                  } else {
                      startForeground(1001, notification)
                  }
              }

              override fun onDestroy() {
                  locationManager.removeUpdates(this)
                  locationManager.unregisterGnssStatusCallback(gnssCallback)
                  wakeLock?.let { if (it.isHeld) it.release() }
                  serviceScope.cancel()
                  super.onDestroy()
              }
          }
